<!DOCTYPE html>
<html lang="ja" id="html">
  <head>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="utf-8">
    <title>お知らせ詳細ページ : <%= @news['title'] %> - 第53回 高専祭</title>
    <link rel="shortcut icon" href="favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/document.css">
    <script src="/js/scroll_change_color.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.slim.min.js" integrity="sha256-u7e5khyithlIdTpu22PHhENmPcRdFiHRjhAuHcs05RI=" crossorigin="anonymous"></script>
    <script>
      function closeMenu(){
          let menu_elem = document.getElementById('menu-ham');
          menu_elem.checked = false;
      }
    </script>
  </head>
  <body id="body" class="scroll-bar scroll-bar-width">
    <div class="loading" id="loading">
      <img src="/img/TMCIT_LOGO_REV_M.png">
    </div>
    
    <section id="top" class="user-top">
      <div class="top-background-img" id="top-backing">
      </div>
      <div class="top-background" id="top-bak">
        <div class="top-content">
          <div>
        </div>
      </div>
      
      <input type="checkbox" id="menu-ham">
      <label for="menu-ham" class="menu-button">
        <span id="hams" class="scroll-changed"></span>
      </label>
      <nav class="menu-container">
        <br>
        <a href="/">Top</a>
        <a href="/search" onclick="closeMenu()" class="">Search</a>
        <a href="/news">News</a>
        <a href="/kousen/mypage">My Page</a>
      </nav>            
      <div class="menu-background scroll-changed" id="menu-bak">
        <h1><div class="header-img"></div></h1>
      </div>            
    </section>
    
    <section class="index-info">
      <div clas="top-header-image">
        <img src="<%= (@news['path']=="NOIMAGE") ? "/img/TMCIT_LOGO_REV_M_HEADER.png" : @news['path'] %>" id="header">        
      </div>
      <div id="user-container" class="user">
        <h1 class="title"><%= @news['title'] %></h1>
        <div class="proj">
          <span class="pcon">
            <span class="ptitle">日　時</span>
            <span class="space"></span>  
            <span class="no-space">          
            <%
              time = Time.parse(@news['date'].to_s)
              year = time.strftime("%Y")
              month = time.strftime("%m")
              day = time.strftime("%d")
              hor = time.strftime("%H")
              min = time.strftime("%M")
              date = time.strftime("%a")
            %>
            <span class="cate-f"><%= year %> 年</span>                    
            <span class="cate-m"><%= month %> 月</span>            
            <span class="cate-b"><%= day %> 日</span>
            <span class="space"></span>        
            <span class="cate-f"><%= hor %> 時</span>                    
            <span class="cate-m"><%= min %> 分</span>            
            <span class="cate-b"><%= date %></span>
            </span>            
          </span>

        </div> 
        <div class="desc" id="desc">
          <%= @news['desc'] %>
        </div>
      </div>
     
      <div class="show">
        <p>

          <a href="#" onclick="history.back(-1);return false;" class="back-link">戻る</a>          
        </p>
      </div>
    </section>
    <footer>
      <p class="copyright"><small>&copy; 2021 Kousen Festival Committee (TMCIT-ACP). All Rights Reserved</small></p>
    </footer>
  </body>
   <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <script>
    // setting (change color)
    window.onload = function(){
        const spinner = document.getElementById('loading');
        spinner.classList.add('loaded');

        var userAgent = window.navigator.userAgent.toLowerCase();
        
        if(userAgent.indexOf('msie') != -1 ||
           userAgent.indexOf('trident') != -1) {
        } else if(userAgent.indexOf('edge') != -1) {
        } else if(userAgent.indexOf('chrome') != -1) {
        } else if(userAgent.indexOf('safari') != -1) {
        } else if(userAgent.indexOf('firefox') != -1) {
        } else if(userAgent.indexOf('opera') != -1) {
        } else {
        }

        var view = document.getElementById('desc');
        var html = marked(desc.innerHTML);
        view.innerHTML = html;
    }
  </script>
</html>
