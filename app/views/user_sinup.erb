<!DOCTYPE html>
<html lang="ja" id="html">

<head>
  <!--　覗いた人への言い訳: 結合テストも単体テストしてないので，バックエンド側にバグあるかもしれないけど，一応セキュリティの対策はしてます -->
  <meta charset="UTF-8">
  <title>Sinup - 第53回 高専祭</title>
  <link rel="shortcut icon" href="/favicon.ico">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/reset.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/user.css">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script>
  var ua = navigator.userAgent.toLowerCase();
  var isiOS = (ua.indexOf('iphone') > -1) || (ua.indexOf('ipad') > -1);
  if(isiOS) {
    var viewport = document.querySelector('meta[name="viewport"]');
    if(viewport) {
      var viewportContent = viewport.getAttribute('content');
      viewport.setAttribute('content', viewportContent + ', user-scalable=no');
    }
  }
  </script>
  <script src="/js/scroll_change_color.js"></script>
  <script src="https://code.jquery.com/jquery-3.6.0.slim.min.js">
    integrity="sha256-u7e5khyithlIdTpu22PHhENmPcRdFiHRjhAuHcs05RI=" crossorigin="anonymous"></script>
  <script>
    function closeMenu() {
      let menu_elem = document.getElementById('menu-ham');
      menu_elem.checked = false;
    }
  </script>
</head>

<body id="body" class="scroll-bar scroll-bar-width">
  <div class="loading" id="loading">
    <img src="favicon.ico">
  </div>

  <section id="top" class="user-top">
    <div class="top-background-img" id="top-backing">
    </div>
    <div class="top-background" id="top-bak">
      <div class="top-content">
        <div>
        </div>
      </div>

      <input type="checkbox" id="menu-ham">
      <label for="menu-ham" class="menu-button">
        <span id="hams" class="scroll-changed"></span>
      </label>
      <nav class="menu-container">
        <br>
        <a href="/">Top</a>
        <a href="/search" onclick="closeMenu()" class="current-page">Search</a>
        <a href="/news">News</a>
        <a href="/mypage">My Page</a>
      </nav>
      <div class="menu-background scroll-changed" id="menu-bak">
        <h1>
          <div class="header-img"></div>
        </h1>
      </div>
  </section>

  <section class="index-info">
    <div id="user-container" class="user">
      <h1>新規ユーザ登録</h1>
      <form method="post" accept-charset="UTF-8" action="/kousenuser/sinup">
        <p class="form-required">姓名</p>
        <div class="input-flex">
          <input name="last_name" type="text" maxlength="20" placeholder="姓" class="form input border-right-none"
            required>
          <input name="first_name" type="text" maxlength="20" placeholder="名" class="form input" required>
        </div>
        <p class="form-required">ふりがな ( 姓名 ) </p>
        <div class="input-flex">
          <input name="last_name_h" type="text" maxlength="20" placeholder="ふりがな(姓)"
            class="form input border-right-none" pattern="[\u3041-\u3096]*" required>
          <input name="first_name_h" type="text" maxlength="20" placeholder="ふりがな(名)" class="form input " pattern="[\u3041-\u3096]*"
            required>
        </div>
        <p class="form-required">種別</p>

        <div class="drop-down-con">
          <div class="drop-down">
            <select name="cate" class="form input" id="select-cate" required>
              <option value="" disabled selected style="display:none;">種別を選択して下さい</option>
              <option value="1">産技高専・本科</option>
              <option value="2">産技高専・専攻科</option>
              <option value="3">中学生</option>
              <option value="4">保護者</option>
              <option value="5">その他</option>
            </select>
            <label for="select-status">▼</label>
          </div>
        </div>

        <p class="form-required">学校名</p>
        <input class="form input" type="text" name="school-name" placeholder="〇〇立〇〇高等専門学校" id="school-name" required>

        <p class="form-required">学年</p>
        <div class="drop-down-con">
          <div class="drop-down">
            <select name="grade" class="form input" id="select-grade" id="grade" required>
              <option value="" disabled selected style="display:none;">学年を選択して下さい</option>
              <option value="1">1</option>
              <option value="2" id="grade-2">2</option>
              <p id="grade-3s">
                <option value="3" id="grade-3">3</option>
              </p>
              <p id="grade-4s">
                <option value="4" id="grade-4">4</option>
              </p>
              <p id="grade-5s">
                <option value="5" id="grade-5">5</option>
              </p>
            </select>
            <label for="select-status">▼</label>
          </div>
        </div>

        <p class="form-required">組・コース名</p>
        <div class="drop-down-con">
          <div class="drop-down">
            <select name="course" class="form input" id="select-course" required>
              <option value="" disabled selected style="display:none;">コース・組を選択して下さい</option>
              <option value="T">情報通信工学コース</option>
              <option value="W">医療福祉工学コース</option>
              <option value="R">ロボット工学コース</option>
              <option value="A">航空宇宙工学コース</option>
            </select>
            <select style="display:none;" name="course" class="form input" id="select-class" required disabled>
              <option value="" disabled selected style="display:none;">コース・組を選択して下さい</option>
              <option value="5">5</option>
              <option value="6">6</option>
              <option value="7">7</option>
              <option value="8">8</option>
            </select>
            <label for="select-status">▼</label>
          </div>
        </div>
        <p class="form-required">パスワード</p>
        <input type="password" class="form input" name="password" id="pass0" required>
        <p class="form-required">パスワード(確認)</p>
        <input type="password" class="form input" id="pass1" required>

        <p class="form-required">メールアドレス</p>
        <input type="email" name="email" class="email" placeholder="example@g.metro-cit.ac.jp" maxlength="60"
          minlength="3"
          pattern="^[a-zA-Z0-9.!#$&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+$"
          required>
        <button type="submit" class="login" id="submit0">認証へ進む ＞</button>
      </form>
    </div>

    <div class="error-show" id="error0">
    </div>
  </section>
  <footer>
    <p class="copyright"><small>&copy; 2021 Kousen Festival Committee (TMCIT-ACP). All Rights Reserved</small></p>
  </footer>
</body>
<script src="/js/password_check.js"></script>
<script src="/js/sinup_select_check.js"></script>
<script>
  // setting (change color)
  window.onload = function () {
    const spinner = document.getElementById('loading');
    spinner.classList.add('loaded');

    var userAgent = window.navigator.userAgent.toLowerCase();

    selectCheck();
    if (userAgent.indexOf('msie') != -1 ||
      userAgent.indexOf('trident') != -1) {
      document.getElementById('select-cate').addEventListener('change', selectCheck)
    } else if (userAgent.indexOf('edge') != -1) {
      document.getElementById('select-cate').addEventListener('change', selectCheck)
    } else if (userAgent.indexOf('chrome') != -1) {
      document.getElementById('select-cate').addEventListener('change', selectCheck)
    } else if (userAgent.indexOf('safari') != -1) {
      selectCheckSafari()
      document.getElementById('select-cate').addEventListener('change', selectCheckSafari)
    } else if (userAgent.indexOf('firefox') != -1) {
      document.getElementById('select-cate').addEventListener('change', selectCheck)
    } else if (userAgent.indexOf('opera') != -1) {
      document.getElementById('select-cate').addEventListener('change', selectCheck)
    } else {
      
    }

    document.getElementById('select-grade').addEventListener('change', checkGradeShowHidden)
    addEventCheckPassDiff();

  }

</script>

</html>