<%
html = ''
@proj_list.each{ |proj|
    html += "<tr>"\
            +"<td>#{proj['id']}</td>"\
            +"<td class=\"center\"><a href=\"/kousenadmin/proj/update/edit?id=#{proj['id']}\">編集</a></td>"\
            +"<td class=\"center\"><label for=\"news-id-#{proj['id']}\"><input id=\"news-id-#{proj['id']}\" name=\"enable[]\" value=\"#{proj['id']}\" type=\"checkbox\"  #{(proj['ena']==1) ? "checked" : ""}></label></td>"\
            +"<td>#{proj['title']}</td>"\
            +"<td>#{proj['organizer']}</td>"\
            +"<td>#{proj['cate']}</td>"\
            +"<td>#{proj['located']}</td>"\
        +"</tr>"
}
%>
<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width,initial-scale=1">
        <title>企画管理 | 高専祭管理者ページ</title>
        <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300&display=swap" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@500&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
        <link rel="stylesheet" href="/css/admin_proj_list.css">
    </head>

    <body>
        <div class="side-menu">
            <div class="title"></div>
            <a href="/kousenadmin/dashboard">
                <i class="fas fa-home"></i>
                <span>DashBoard</span>
            </a>
            <a href="/kousenadmin/news/dashboard">
                <i class="fas fa-newspaper"></i>
                <span>News</span>
            </a>
            <a href="/kousenadmin/proj/dashboard">
                <i class="fas fa-calendar-alt"></i>
                <span>Projects</span>
            </a>
            <a href="/kousenadmin/bingo/dashboard">
                <i class="fas fa-dice"></i>
                <span>Bingo</span>
            </a>
            <a href="/kousenadmin/qr/dashboard">
                <i class="fas fa-qrcode"></i>
                <span>QR</span>
            </a>
            <a href="/kousenadmin/users/dashboard">
                <i class="fas fa-users"></i>
                <span>Users</span>
            </a>
            <a href="/kousenadmin/adnmins/dashboard">
                <i class="fas fa-users-cog"></i>
                <span>Admins</span>
            </a>
            <a href="/kousenadmin/logout">
                <i class="fas fa-sign-out-alt logout"></i>
                <span>Logout</span>
            </a>        
        </div>
        <div class="main-content">
            <form action="/kousenadmin/proj/update/showing_list" charset="utf-8" method="post">
                <div class="menu">
                    <a href="/kousenadmin/proj/update/add" class="green">新規企画</a>&nbsp;
                    <button type="submit" class="green">表示設定を保存・送信</button>
                </div>
                <div class="table-container">
                    <table>
                        <tr>
                            <th>ID</th>
                            <th class="center">操作</th>
                            <th class="center">表示</th>
                            <th>企画タイトル</th>
                            <th>企画者・組織</th>
                            <th>企画形態</th>
                            <th>企画場所</th>
                        </tr>
                        <%= html %>
                    </table>
                </div>
            </form> 
        </div>
    </body>

</html>