<%
  news_str = ''
  @news_ary.each { |news|
  is_noimg = ''
  if (news['img']==''||news['img']==nil||news['img']=="NOIMAGE")
    is_noimg = 'none'
    news['img'] = '/img/TMCIT_LOGO_REV.png'
  end 
  is_show_newmark = ''
  is_show_newmark = ((Time.now - news['notify_time'])<(15*60)) ? 'new' : '' 
news_str += "<div class=\"thum-one-container pointer\">"\
            + "<a href=\"/news/detail?id=#{news['id']}\">"\
              + "<div class=\"thum-one #{is_show_newmark}\">"\
                + "<div class=\"thum-one-icon #{is_noimg} pointer\">"\
                  + "<img src=\"#{news['img']}\" class=\"\">"\
                + "</div>"\
                + "<div class=\"thum-one-context\">"\
                  + "<h4>#{news['title']}</h4>"\
                  + "<p><small>#{news['date']}</small><br>#{news['summary']}</p>"\
                + "</div>"\
              + "</div>"\
            + "</a>"\
          +"</div>"
  }

  proj_str=''
  @proj_ary.each{ |proj|
    is_noimg = ''
    if(proj['img']==''||proj['img']==nil||proj['img']=="NOIMAGE")
      is_noimg = 'none'
      proj['img'] = '/img/TMCIT_LOGO_REV.png'
    end
    is_show_newmark = ''
    p proj
    is_show_newmark = ((Time.now - proj['time'])<(30*60)) ? 'new' : ''
    proj_str += "<div class=\"thum-one-container\">"\
          +"<a href=\"/proj/detail?id=#{proj['id']}\">"\
            +"<div class=\"thum-one #{is_show_newmark}\">"\
              +"<div class=\"thum-one-icon #{is_noimg}\">"\
                +"<img src=\"#{proj['img']}\" class=\"\">"\
              +"</div>"\
              +"<div class=\"thum-one-context\">"\
                +"<h4 class=\"white\"><span style=\"color: white; background: #0A62A9; padding: 2px 4px 3px 4px;border-radius: 2px;\">#{proj['cate']}</span>　#{proj['title']}</h4>"\
                +"<p class=\"white\"><small>#{proj['org']}</small><br>#{proj['desc']}"\
                +"</p>"\
              +"</div>"\
            +"</div>"\
          +"</a>"\
        +"</div>"

  }
%>

