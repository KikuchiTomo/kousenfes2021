<script>
  // setting (change color)
  window.onload = function () {
    const spinner = document.getElementById('loading');
    spinner.classList.add('loaded');

    var userAgent = window.navigator.userAgent.toLowerCase();
    var ani = document.getElementById("top-backing")

    if (userAgent.indexOf('msie') != -1 ||
      userAgent.indexOf('trident') != -1) {
      isWebKits =
        ani.classList.add("can-animation")
    } else if (userAgent.indexOf('edge') != -1) {
      observe_target = document.body;
      ani.classList.add("can-animation")
    } else if (userAgent.indexOf('chrome') != -1) {
      observe_target = document.body;
      ani.classList.add("can-animation")
    } else if (userAgent.indexOf('safari') != -1) {
      observe_target = document.body;
      ani.classList.add("can-animation")
    } else if (userAgent.indexOf('firefox') != -1) {
      observe_target = document.documentElement;
      ani.classList.add("can-animation")
    } else if (userAgent.indexOf('opera') != -1) {
      observe_target = document.documentElement;
      ani.classList.add("can-animation")
    } else {
    }

    var isWebKits = false;

    if (navigator.userAgent.toLowerCase().match(/webkit|msie 5/)) {
      isWebKits = false;
    } else {
      isWebKits = true;
    }

    var cc = new scrollChangeClass({
      is_webkits_client: isWebKits,
      observe_target_elem: observe_target,
      color_target_ids: ['hams', 'menu-bak'],
      trigger_target_id: 'top',
      class_name: 'scroll-changed'
    });

    cc.proc(); // リロード時用

    window.onscroll = scroll = () => {
      cc.proc()
    }

    // });
    alert("サイトは未完成です．開発中ですので，情報を信頼しないでください");
  }
</script>

