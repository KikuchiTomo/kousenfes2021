<!DOCTYPE html>
<html lang="ja" id="html">
  <head>
    <!--　覗いた人への言い訳: 結合テストも単体テストしてないので，バックエンド側にバグあるかもしれないけど，一応セキュリティの対策はしてます -->
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="utf-8">
    <title>企画一覧 - 第53回 高専祭</title>
    <link rel="shortcut icon" href="favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/search.css">
    <script src="/js/scroll_change_color.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.slim.min.js" integrity="sha256-u7e5khyithlIdTpu22PHhENmPcRdFiHRjhAuHcs05RI=" crossorigin="anonymous"></script>
    <script>
      function closeMenu(){
          let menu_elem = document.getElementById('menu-ham');
          menu_elem.checked = false;
      }
    </script>
  </head>
  <body id="body" class="scroll-bar scroll-bar-width">
    <div class="loading" id="loading">
      <img src="favicon.ico">
    </div>
    
    <section id="top" class="search-top">
      <div class="top-background-img" id="top-backing">
      </div>
    
      
      <input type="checkbox" id="menu-ham">
      <label for="menu-ham" class="menu-button">
        <span id="hams" class="scroll-changed"></span>
      </label>
      <nav class="menu-container">
        <br>
        <a href="/">Top</a>
        <a href="/search" onclick="closeMenu()" class="current-page">Search</a>
        <a href="/news">News</a>
        <a href="/mypage">My Page</a>
      </nav>            
      <div class="menu-background scroll-changed" id="menu-bak">
        <h1><div class="header-img"></div></h1>
      </div>            
    </section>
    
    <section class="index-info">
      <div class="top-background" id="top-bak">
        <div class="top-content">
          
          <form charset="utf-8" method="get" action="/search" class="search-form">
            <div class="search-win"><input name="words" type="search" maxlength="256" id="search" value="<%= @user_input_words %>"><input type="submit" value="検 索"></div>
            <div class="select-container">
              <label>
              <select name="cate">
                <% 
                        cate_html = '<option value="-1">企画形態を選択</option>'
                        @cates.each{ |cate|
                            cate_html += "<option value=\"#{cate[0]}\" #{(cate[0]==@user_input_cate) ? "selected" : "" }>#{cate[1]}</option>"
                        }
                %>
                
                <%= cate_html %>              
              </select>
              </label>
            </div>
             <div class="select-container2 ">
              <label>
              <select name="floor">
                <option value="-1">階を選択</option>
                <option value="0">校内全域</option>
                <option value="1">1 階</option>
                <option value="2">2 階</option>
                <option value="3">3 階</option>
                <option value="4">4 階</option>
                <option value="5">5 階</option>
                <option value="6">6 階</option>
                <option value="7">7 階</option>
                <option value="8">8 階</option>
              </select>
              </label>
            </div>
          </form>
          
        </div>
      </div>
      <h1 class="white">企画検索</h1>
      <br><br>
      <div class="info-title">
        <h2 class="white">検索結果</h2>
        <p><small class="white">ヒット件数 <%= @hit %> 件</small></p>        
      </div>   
      <% 
        if @hit>0
          row = (@hit / 2).floor
          remain = @hit % 2
          puts "row #{row} , remain #{remain}"

          html = ''
          idx=0
          for i in 0..row-1
            html+="<div class=\"info-content\">"
            for j in 0..1
              
              html  +="<a href=\"/proj/detail?id=#{@show[idx]['id']}\">"\
                        +"<div class=\"thum-simple-one #{(@show[idx]['img']=="NOIMAGE") ? "none" : ""}\">"\
                          +"<div class=\"thum-simple-one-img\">"\
                          +"#{(@show[idx]['img']!="NOIMAGE") ? "<img src=\"" + @show[idx]['img'] + "\">" : ""}"\
                          +"</div>"\
                          +"<div class=\"thum-sinple-one-content\">"\
                            +"<h3 class=\"white small\">#{@show[idx]['title']}</h3>"\
                            +"<p class=\"white vsmall\">主催 #{@show[idx]['org']}</p>"\
                            +"<p class=\"white vsmall\">種類 #{@show[idx]['cate']}</p>"\
                            +"<p class=\"desc\">"\
                              +"<small class=\"white vsmall\">"\
                              +"#{@show[idx]['desc']}"\
                              +"</small>"\
                            +"</p>"\
                            +"<p></p>"\
                          +"</div>"\
                        +"</div>"\
                      +"</a>"

              idx+=1
            end
            html+="</div>"
          end
          
          if remain==1
           lidx = row*2+remain-1
           html+="<div class=\"info-content\">"         
           html  +="<a href=\"/proj/detail?id=#{@show[lidx]['id']}\">"\
                        +"<div class=\"thum-simple-one #{(@show[lidx]['img']=="NOIMAGE") ? "none" : ""}\">"\
                          +"<div class=\"thum-simple-one-img\">"\
                          +"#{(@show[lidx]['img']!="NOIMAGE") ? "<img src=\"" + @show[lidx]['img'] + "\">" : ""}"\
                          +"</div>"\
                          +"<div class=\"thum-sinple-one-content\">"\
                            +"<h3 class=\"white small\">#{@show[lidx]['title']}</h3>"\
                            +"<p class=\"white vsmall\">主催 #{@show[lidx]['org']}</p>"\
                            +"<p class=\"white vsmall\">種類 #{@show[lidx]['cate']}</p>"\
                            +"<p class=\"desc\">"\
                              +"<small class=\"white vsmall\">"\
                              +"#{@show[lidx]['desc']}"\
                              +"</small>"\
                            +"</p>"\
                            +"<p></p>"\
                          +"</div>"\
                        +"</div>"\
                      +"</a>"\
                  +"</div>"
                  end
        end
      %>

  <%= html %>
    <div  class="nohit" style="<%= (@hit==0) ? "" : "display: none;" %>">
      お探しの企画はありません。
    </div>
    </section>
    <div class="footer-container">
      <footer>
        <p class="copyright"><small>&copy; 2021 Kousen Festival Committee (TMCIT-ACP). All Rights Reserved</small></p>
      </footer>
    </div>
  </body>
  <script>
    // setting (change color)
    window.onload = function(){
        const spinner = document.getElementById('loading');
        spinner.classList.add('loaded');

        var userAgent = window.navigator.userAgent.toLowerCase();
        
        if(userAgent.indexOf('msie') != -1 ||
           userAgent.indexOf('trident') != -1) {
        } else if(userAgent.indexOf('edge') != -1) {
        } else if(userAgent.indexOf('chrome') != -1) {
        } else if(userAgent.indexOf('safari') != -1) {
        } else if(userAgent.indexOf('firefox') != -1) {
        } else if(userAgent.indexOf('opera') != -1) {
        } else {
        }
    }
  </script>
</html>
