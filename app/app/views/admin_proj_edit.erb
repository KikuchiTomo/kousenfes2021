<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>企画編集・追加 | 高専祭管理者ページ</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link rel="stylesheet" href="/css/admin_proj_edit.css">
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/image_upload.js"></script>    
</head>

<body>
  <div class="body">
    <div class="side-menu">
        <div class="title"></div>
        <a href="/kousenadmin/proj/dashboard">
            <i class="fas fa-calendar-alt"></i>
            <span>Projects</span>
        </a>
    </div>
    <div class="main-content">
        <form action="/kousenadmin/proj/update/edit" method="post" accept-charset="utf-8">
            <div class="menu">
                <button type="submit" class="green">サーバにアップロード</button>&nbsp;
                <a href="/kousenadmin/proj/update/delete?id=<%= @proj['id'] %>" class="red"  onclick="return confirm('本当に削除しますか？')">この企画を削除</a>
            </div>
            <div class="main-container">
                <small>ICON画像</small>
                <div>
                 <div style="height:5px; width: 180px; background: #f5c4c4;">
                        <div style="height: 5px; background: lightgreen;" id="icon-prog"></div>
                    </div>
                    <img id="preview-area-icon" src="<%= (@proj['icon']=="NOIMAGE") ? "/img/TMCIT_LOGO_REV_M.png" : @proj['icon'] %>" style="height:180px; width: 180px; object-fit: contain;">
                    <input type="file" id="icon-picker">                    
                    <input type="hidden" name="icon_path" id="icon-pics" value="<%= @proj['icon'] %>">
                </div>
                <small>ヘッダー画像</small>
                <div>
                    <div style="height:5px; width: 180px; background: #f5c4c4;">
                        <div style="height: 5px; background: lightgreen;" id="image-prog"></div>
                    </div>
                    <img id="preview-area-image" src="<%= (@proj['image']=="NOIMAGE") ? "/img/TMCIT_LOGO_REV_M.png" : @proj['image'] %>" style="height:180px; width: 180px; object-fit: contain;">
                    <input type="file" id="image-picker">
                    <input type="hidden" name="image_path" id="image-pics" value="<%= @proj['image'] %>">
                </div>
                <input type="hidden" name="id" value="<%= @proj['id'] %>" required>
                <small>企画タイトル</small>
                <input type="text" name="title" maxlength="30" placeholder="例：ワクワクライブなど" value="<%= @proj['title'] %>" required>
                <small>企画者名・組織名</small>
                <input type="text" name="organizer" maxlength="30" placeholder="例：〇〇部・〇〇同好会・〇〇研究室など" value="<%= @proj['organizer'] %>" required>
                <small>企画場所</small>
                <select name="located" required>
                    <% 
                        locate_html = ''
                        @locates.each{ |locate|
                            locate_html += "<option value=\"#{locate[0]}\" #{(locate[0]==@proj['located'].to_i) ? "selected" : "" }>#{locate[1]}</option>"
                        }
                    %>
                    <%= locate_html %>
                </select>
                <small>企画種類</small>
                <select name="cate" required>
                    <% 
                        cate_html = ''
                        @cates.each{ |cate|
                            cate_html += "<option value=\"#{cate[0]}\" #{(cate[0]==@proj['cate'].to_i) ? "selected" : "" }>#{cate[1]}</option>"
                        }
                    %>
                    <%= cate_html %>
                </select>
                <small>企画内容(詳細画面に表示)<small>[Markdown形式]</small></small>
                <textarea name="description" id="content" required><%= @proj['desc'] %></textarea>
                <small>企画内容summary(TOPページに表示)</small>
                <input type="text" name="sub_description" maxlength="30" placeholder="例：○○部のライブです！など" value="<%= @proj['sub_desc'] %>" required>
                <small>タグ</small>
                <textarea name="tags" id="content" required><%= @proj['tags'] %></textarea>
                <small>検索キーワード</small>
                <textarea name="words" id="content" required><%= @proj['words'] %></textarea>
                <small>プレビュー</small>
                <div id="preview-area" class="preview">

                </div>            
            </div>      
        <form>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script>
        window.onload = () => {
            var m = document.getElementById('content');

            m.addEventListener('keyup', () => {
                var view = document.getElementById('preview-area');
                var html = marked(document.getElementById('content').value);
                view.innerHTML = html;
            })

              var icon_ajax = new ajaxImageController({
                img_input: "icon-picker",
                view_area: "preview-area-icon",
                prog_area: "icon-prog",
                img_src_input: "icon-pics"
            });

            var image_ajax = new ajaxImageController({
                img_input: "image-picker",
                view_area: "preview-area-image",
                prog_area: "image-prog",
                img_src_input: "image-pics"
            });        
        }
    </script>
    </div>
    </body>
</html>
